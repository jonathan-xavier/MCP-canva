# Endpoint remoto oficial do Canva MCP.
CANVA_MCP_URL=https://mcp.canva.com/mcp

# Tempo máximo para cada chamada de ferramenta. Geração pode demorar.
CANVA_MCP_TIMEOUT_MS=120000

# Porta da API usada pelo front local. O servidor aceita apenas loopback.
CANVA_WEB_API_PORT=3000

# Opcional: diretório de autenticação do mcp-remote.
# Não use uma pasta versionada e não compartilhe seu conteúdo.
# MCP_REMOTE_CONFIG_DIR=/caminho/privado/para/tokens
